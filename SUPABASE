CREATE TABLE public.compras_seguros (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  dni TEXT NOT NULL,
  celular TEXT NOT NULL,
  plan TEXT,
  extra TEXT,
  monto NUMERIC(10,2)
);

ALTER TABLE public.compras_seguros ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Permitir inserciones públicas" 
ON public.compras_seguros 
FOR INSERT 
WITH CHECK (true);

CREATE POLICY "Permitir lectura pública" 
ON public.compras_seguros 
FOR SELECT 
USING (true);
